# Solari: one key for the cloud browser and the gym sandbox
# Get one at https://console.getsolari.com
SOLARI_API_KEY=slr_live_...

# The model that drives the agent. Anthropic by default (claude-sonnet-5-5).
ANTHROPIC_API_KEY=sk-ant-...
# AI_MODEL=claude-opus-5

# Or any OpenAI-compatible API: OpenAI, Gemini, OpenRouter, Groq, a local Ollama.
# The model must support tool calling.
# AI_PROVIDER=openai
# OPENAI_API_KEY=...
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# AI_MODEL=gemini-2.5-pro
